# ── Database (Neon Postgres) ──────────────────────────────────
# Pooled connection — the host contains "-pooler". Used by the app at runtime.
DATABASE_URL=
# Direct / unpooled connection. Used by `npm run db:push` and migrations.
DIRECT_URL=

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=                # Long random string used to sign JWTs
JWT_EXPIRES_IN=7d          # Token lifetime (default 7d)

# ── Accounts (auto-created on first login) ────────────────────
OWNER_EMAIL=
OWNER_PASSWORD=
MANAGER_EMAIL=
MANAGER_PASSWORD=

# ── Cloudinary (server-side signed uploads for expense receipts) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional ──────────────────────────────────────────────────
# Override the API origin (only for split frontend/backend deploys)
# VITE_API_URL=
