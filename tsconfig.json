{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@contracts/*": ["./contracts/*"],
      "@db/*": ["./db/*"]
    },
    "jsx": "react-jsx",
    "esModuleInterop": true
  },
  "include": ["api", "db", "contracts", "src"],
  "exclude": ["node_modules", "dist"]
}
